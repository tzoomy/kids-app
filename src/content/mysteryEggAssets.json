  "vo-fr-intro-1": {
    "path": "audio/mystery-egg/vo-fr-intro-1.ogg",
    "kind": "vo",
    "transcript": "Oh ! Un œuf ! Il est tout chaud…",
    "lang": "fr",
    "pending": true
  },
  "vo-he-intro-1": {
    "path": "audio/mystery-egg/vo-he-intro-1.ogg",
    "kind": "vo",
    "transcript": "ביצה? איזו הפתעה… יש מישהו בפנים.",
    "lang": "he",
    "pending": true
  },
  "vo-fr-intro-2": {
    "path": "audio/mystery-egg/vo-fr-intro-2.ogg",
    "kind": "vo",
    "transcript": "Mon petit robot… tu ne sais pas encore sentir.",
    "lang": "fr",
    "pending": true
  },
  "vo-he-intro-2": {
    "path": "audio/mystery-egg/vo-he-intro-2.ogg",
    "kind": "vo",
    "transcript": "אני יודע לחשוב ולבנות. אבל הלב שלי עוד ריק. אני לא יודע להרגיש.",
    "lang": "he",
    "pending": true
  },
  "vo-fr-intro-3": {
    "path": "audio/mystery-egg/vo-fr-intro-3.ogg",
    "kind": "vo",
    "transcript": "Regarde ! Il y a des mondes à explorer.",
    "lang": "fr",
    "pending": true
  },
  "vo-he-intro-3": {
    "path": "audio/mystery-egg/vo-he-intro-3.ogg",
    "kind": "vo",
    "transcript": "זאת המפה. בכל עולם יש משחק אחר. אפשר ללכת לשם עם החברים, על השביל.",
    "lang": "he",
    "pending": true
  },
  "vo-fr-intro-4": {
    "path": "audio/mystery-egg/vo-fr-intro-4.ogg",
    "kind": "vo",
    "transcript": "Des cœurs pour mon robot… et des trésors pour le nid.",
    "lang": "fr",
    "pending": true
  },
  "vo-he-intro-4": {
    "path": "audio/mystery-egg/vo-he-intro-4.ogg",
    "kind": "vo",
    "transcript": "כשמסיימים משחק, אני מקבל גלגל לב ולומד להרגיש. ואחרי כמה משחקים בעולם, הביצה מקבלת חלק חשוב לקן. ככה היא תוכל לבקוע.",
    "lang": "he",
    "pending": true
  },
  "vo-fr-workshop-entry-1": {
    "path": "audio/mystery-egg/vo-fr-workshop-entry-1.ogg",
    "kind": "vo",
    "transcript": "Voici l'atelier ! Ici, on construit des machines.",
    "lang": "fr",
    "pending": true
  },
  "vo-he-workshop-entry-1": {
    "path": "audio/mystery-egg/vo-he-workshop-entry-1.ogg",
    "kind": "vo",
    "transcript": "זאת הסדנה! כאן בונים מכונות מצחיקות, אחת אחרי השנייה, כמו שרשרת.",
    "lang": "he",
    "pending": true
  },
  "vo-fr-workshop-entry-2": {
    "path": "audio/mystery-egg/vo-fr-workshop-entry-2.ogg",
    "kind": "vo",
    "transcript": "Clic, clac… boum ! On y va ?",
    "lang": "fr",
    "pending": true
  },
  "vo-he-workshop-entry-2": {
    "path": "audio/mystery-egg/vo-he-workshop-entry-2.ogg",
    "kind": "vo",
    "transcript": "כשמצליחים, אני מקבל קצת צחוק לגלגל הלב. ואחרי כמה משחקים, הביצה מקבלת חלק חשוב. יאללה, בואו נשחק!",
    "lang": "he",
    "pending": true
  },
  "vo-he-robot-locked": {
    "path": "audio/mystery-egg/vo-he-robot-locked.ogg",
    "kind": "vo",
    "transcript": "העולם הזה עוד ישן. בואי נלך לסדנה!",
    "lang": "he",
    "pending": true
  },
