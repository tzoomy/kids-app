  "vo-shell-intro-1-narr": { "path": "audio/game-shell/vo-shell-intro-1-narr.ogg", "kind": "vo", "transcript": "ביצה חמה התגלגלה לכיכר!", "lang": "he" },
  "vo-shell-intro-2-hero": { "path": "audio/game-shell/vo-shell-intro-2-hero.ogg", "kind": "vo", "transcript": "Mon petit robot… tu ne sais pas encore sentir.", "lang": "fr" },
  "vo-shell-intro-2-robot": { "path": "audio/game-shell/vo-shell-intro-2-robot.ogg", "kind": "vo", "transcript": "הלב שלי עוד ריק. אני לא יודע להרגיש.", "lang": "he" },
  "vo-shell-intro-3-hero": { "path": "audio/game-shell/vo-shell-intro-3-hero.ogg", "kind": "vo", "transcript": "On va t'aider, petit œuf. Promis !", "lang": "fr" },
  "vo-shell-intro-3-robot": { "path": "audio/game-shell/vo-shell-intro-3-robot.ogg", "kind": "vo", "transcript": "נבנה לך קן חם, un nid. וגם אני אלמד להרגיש.", "lang": "he" },
  "vo-shell-intro-4-hero": { "path": "audio/game-shell/vo-shell-intro-4-hero.ogg", "kind": "vo", "transcript": "Regarde ! Des cœurs… et des trésors pour le nid.", "lang": "fr" },
  "vo-shell-intro-4-narr": { "path": "audio/game-shell/vo-shell-intro-4-narr.ogg", "kind": "vo", "transcript": "מצליחים — הרובוט מקבל לב, un cœur. כמה משחקים — מתנה לקן. ככה הביצה תבקע!", "lang": "he" },
  "vo-shell-ws-1-hero": { "path": "audio/game-shell/vo-shell-ws-1-hero.ogg", "kind": "vo", "transcript": "Voici l'atelier ! Monsieur Moustache dort !", "lang": "fr" },
  "vo-shell-ws-1-narr": { "path": "audio/game-shell/vo-shell-ws-1-narr.ogg", "kind": "vo", "transcript": "החתול האופה ישן. בואי נעיר אותו!", "lang": "he" },
  "vo-shell-ws-2-robot": { "path": "audio/game-shell/vo-shell-ws-2-robot.ogg", "kind": "vo", "transcript": "שמים חלקים, לוחצים על נגן, והכדור, la balle, מתגלגל!", "lang": "he" }
