    "he.map.comingSoon": {
      "start": 11.09,
      "end": 14.61,
      "heard": "המקום הזה עוד בבנייה. נבקר בו בקרוב!"
    },
    "he.restaurant.intro": {
      "start": 15.7,
      "end": 25.34,
      "heard": "ברוכה הבאה למסעדת החיות! החיות רעבות. הקשיבי מה הן מבקשות, ובחרי את הצלחת המתאימה."
    },
    "he.restaurant.help": {
      "start": 26.31,
      "end": 34.25,
      "heard": "החיה מבקשת אוכל. הקשיבי ובחרי את הצלחת המתאימה. אפשר ללחוץ על החיה כדי לשמוע שוב."
    },
    "he.retry.0": {
      "start": 35.14,
      "end": 37.47,
      "heard": "כמעט! בואי נקשיב שוב."
    },
    "he.retry.1": {
      "start": 38.4,
      "end": 41.46,
      "heard": "הממ, זה לא זה. ננסה שוב?"
