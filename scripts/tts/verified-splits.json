    "he.retry.2": {
      "start": 41.97,
      "end": 45.16,
      "heard": "לא נורא! הקשיבי לחיה ונסי שוב."
    },
    "he.praise.0": {
      "start": 46.14,
      "end": 47.27,
      "heard": "כל הכבוד!"
    },
    "he.praise.1": {
      "start": 48.23,
      "end": 50.11,
      "heard": "איזו מלצרית מעולה!"
    },
    "he.praise.2": {
      "start": 51.24,
      "end": 53.61,
      "heard": "יופי! החיה ממש שמחה!"
    },
    "he.leisure.earned": {
      "start": 54.55,
      "end": 56.03,
      "heard": "הרווחת עוד זמן כיף!"
    },
    "he.bubbles.intro": {
      "start": 56.92,
      "end": 59.3,
